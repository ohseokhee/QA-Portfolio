    {
      "name": "TC-SHOP-01·02 확인: 구매 후 재화 재조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('FC는 101 구매분(2000)만 차감, BP 구매로 변화 없음', function () {",
              "    pm.expect(body.balances.FC).to.eql(Number(pm.environment.get('user1_fc_after_shop01')));",
              "    pm.expect(body.balances.FC).to.eql(Number(pm.environment.get('user1_fc_before')) - 2000);",
              "});",
              "",
              "pm.test('BP는 103 구매분(10000)만 차감', function () {",
              "    pm.expect(body.balances.BP).to.eql(Number(pm.environment.get('user1_bp_before')) - 10000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
