    {
      "name": "TC-CUR-01 재화 조회 (본인)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('account_id가 토큰의 계정과 일치', function () {",
              "    pm.expect(body.account_id).to.eql(Number(pm.environment.get('user1_account_id')));",
              "});",
              "",
              "pm.test('balances에 FC·BP 키 모두 존재', function () {",
              "    pm.expect(body.balances).to.have.all.keys('FC', 'BP');",
              "});",
              "",
              "pm.test('잔액은 0 이상 99,999,999 이하 정수 (R1)', function () {",
              "    ['FC', 'BP'].forEach(function (c) {",
              "        pm.expect(Number.isInteger(body.balances[c]), c + ' 정수').to.be.true;",
              "        pm.expect(body.balances[c]).to.be.within(0, 99999999);",
              "    });",
              "});",
              "",
              "pm.environment.set('user1_fc_before', body.balances.FC);",
              "pm.environment.set('user1_bp_before', body.balances.BP);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user1_token}}" }],
        "url": "{{base_url}}/accounts/{{user1_account_id}}/currency"
      }
    },
