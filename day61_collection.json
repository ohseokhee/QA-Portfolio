      }
    },
    {
      "name": "TC-INV-01 인벤토리 조회 (구매 후 본인)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const qty = function (id) {",
              "    const found = body.items.find(function (i) { return i.item_id === id; });",
              "    return found ? found.quantity : 0;",
              "};",
              "",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('항목마다 item_id·name·quantity 존재', function () {",
              "    body.items.forEach(function (i) {",
              "        pm.expect(i).to.have.all.keys('item_id', 'name', 'quantity');",
              "    });",
              "});",
              "",
              "pm.test('101 수량 = 구매 전 + 2, 103 수량 = 구매 전 + 1', function () {",
              "    pm.expect(qty(101)).to.eql(Number(pm.environment.get('user1_inv101_before')) + 2);",
              "    pm.expect(qty(103)).to.eql(Number(pm.environment.get('user1_inv103_before')) + 1);",
              "});",
              "",
              "pm.test('수량 0 항목 없음, item_id 오름차순', function () {",
              "    const ids = body.items.map(function (i) { return i.item_id; });",
              "    pm.expect(body.items.every(function (i) { return i.quantity > 0; })).to.be.true;",
              "    pm.expect(ids).to.eql(ids.slice().sort(function (a, b) { return a - b; }));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user1_token}}" }],
        "url": "{{base_url}}/accounts/{{user1_account_id}}/inventory"
      }
    },
    {
      "name": "TC-INV-02 인벤토리 조회 (구매 이력 없는 계정)",
