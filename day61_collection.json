    {
      "name": "TC-SHOP-01 구매 101 x 2 (FC)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('request_id_shop01', 'day61-shop01-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const fcBefore = Number(pm.environment.get('user1_fc_before'));",
              "const invBefore = Number(pm.environment.get('user1_inv101_before'));",
              "",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('응답 필드 8개 존재', function () {",
              "    pm.expect(body).to.have.all.keys('purchase_id', 'item_id', 'quantity', 'unit_price',",
              "        'total_price', 'currency_type', 'balance_after', 'inventory_quantity');",
              "});",
              "",
              "pm.test('item 101, 수량 2, 단가 1000, FC', function () {",
              "    pm.expect(body.item_id).to.eql(101);",
              "    pm.expect(body.quantity).to.eql(2);",
              "    pm.expect(body.unit_price).to.eql(1000);",
              "    pm.expect(body.currency_type).to.eql('FC');",
              "});",
              "",
              "pm.test('total_price = 단가 x 수량 = 2000 (R5)', function () {",
              "    pm.expect(body.total_price).to.eql(body.unit_price * body.quantity);",
              "    pm.expect(body.total_price).to.eql(2000);",
              "});",
              "",
              "pm.test('balance_after = 구매 전 FC - 2000', function () {",
              "    pm.expect(body.balance_after).to.eql(fcBefore - 2000);",
              "});",
              "",
              "pm.test('inventory_quantity = 구매 전 보유 + 2', function () {",
              "    pm.expect(body.inventory_quantity).to.eql(invBefore + 2);",
              "});",
              "",
              "pm.environment.set('user1_fc_after_shop01', body.balance_after);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user1_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"item_id\": 101, \"quantity\": 2, \"request_id\": \"{{request_id_shop01}}\" }" },
        "url": "{{base_url}}/shop/purchase"
      }
    },
