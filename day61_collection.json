    {
      "name": "준비: 구매 전 qa_user1 인벤토리 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const qty = function (id) {",
              "    const found = body.items.find(function (i) { return i.item_id === id; });",
              "    return found ? found.quantity : 0;",
              "};",
              "pm.environment.set('user1_inv101_before', qty(101));",
              "pm.environment.set('user1_inv103_before', qty(103));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user1_token}}" }],
        "url": "{{base_url}}/accounts/{{user1_account_id}}/inventory"
      }
