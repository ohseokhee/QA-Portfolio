{
  "info": {
    "name": "Day61 모의 게임 서버 정상 흐름",
    "description": "day59_api_spec.md 4.3의 실행 Day 61 TC 8건. 로그인 응답의 토큰을 환경 변수에 저장해 다음 요청에 사용 (요청 체이닝)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('[공통] 응답 시간 ' + pm.environment.get('max_response_ms') + 'ms 미만', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('max_response_ms')));",
          "});",
          "",
          "pm.test('[공통] Content-Type JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "TC-AUTH-01 로그인 qa_user1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('응답 필드 4개 존재', function () {",
              "    pm.expect(body).to.have.all.keys('access_token', 'token_type', 'expires_in', 'account_id');",
              "});",
              "",
              "pm.test('access_token은 64자리 hex', function () {",
              "    pm.expect(body.access_token).to.match(/^[0-9a-f]{64}$/);",
              "});",
              "",
              "pm.test('token_type Bearer, expires_in 1800', function () {",
              "    pm.expect(body.token_type).to.eql('Bearer');",
              "    pm.expect(body.expires_in).to.eql(1800);",
              "});",
              "",
              "pm.test('account_id 1 (시드 계정)', function () {",
              "    pm.expect(body.account_id).to.eql(1);",
              "});",
              "",
              "pm.environment.set('user1_token', body.access_token);",
              "pm.environment.set('user1_account_id', body.account_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"username\": \"{{user1_username}}\", \"password\": \"{{user1_password}}\" }" },
        "url": "{{base_url}}/auth/login"
      }
    },
