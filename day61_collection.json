    {
      "name": "TC-GRANT-01 재화 지급 (ADMIN, FC 5000)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const before = Number(pm.environment.get('user2_fc_before'));",
              "",
              "pm.test('상태 코드 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('응답 필드 5개 존재, tx_id 양의 정수', function () {",
              "    pm.expect(body).to.have.all.keys('tx_id', 'account_id', 'currency_type', 'amount', 'balance_after');",
              "    pm.expect(Number.isInteger(body.tx_id) && body.tx_id > 0).to.be.true;",
              "});",
              "",
              "pm.test('요청 값 그대로 반환 (account_id, FC, 5000)', function () {",
              "    pm.expect(body.account_id).to.eql(Number(pm.environment.get('user2_account_id')));",
              "    pm.expect(body.currency_type).to.eql('FC');",
              "    pm.expect(body.amount).to.eql(5000);",
              "});",
              "",
              "pm.test('balance_after = 지급 전 잔액 + 5000', function () {",
              "    pm.expect(body.balance_after).to.eql(before + 5000);",
              "});",
              "",
              "pm.environment.set('user2_fc_after_grant', body.balance_after);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
